{
  "postfix": [
    "# Hardening Postfix for TLS 1.3 and Perfect Forward Secrecy",
    "smtpd_tls_security_level = encrypt",
    "smtpd_tls_protocols = !SSLv2, !SSLv3, !TLSv1, !TLSv1.1, TLSv1.2, TLSv1.3",
    "smtpd_tls_mandatory_protocols = !SSLv2, !SSLv3, !TLSv1, !TLSv1.1, TLSv1.2, TLSv1.3",
    "smtpd_tls_ciphers = high",
    "smtpd_tls_mandatory_ciphers = high",
    "tls_high_cipherlist = ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384",
    "smtpd_tls_eecdh_grade = ultra",
    "smtp_tls_security_level = dane",
    "smtp_dns_support_level = dnssec"
  ]
}